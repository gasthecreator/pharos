# pharos-cli container image (PLAN.md Slice 17: Deployment automation) --
# used as a one-off in-cluster Job for admin tasks like provisioning a
# site's API key (deploy/k8s/09-provision-demo-key-job.yaml), so it never
# needs a host-side port-forward to reach Cassandra just to run a CLI
# command. See Dockerfile.ingestion for why scratch + CGO_ENABLED=0 is
# genuinely sufficient (no cgo anywhere in this project).
# Builder base is pinned by digest as well as tag (supply-chain: a tag can be
# re-pushed, a digest cannot); Dependabot's docker ecosystem refreshes both.
FROM golang:1.26-alpine@sha256:3082400e369fa24d5fc60bca20edab3f6d604e0c5a690ec66b295eff4dd87ade AS builder
RUN apk add --no-cache ca-certificates
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Writable working directory for the one binary-local path this service
# creates files in (edge: its SQLite WAL queue and backups; cli: the
# `archive run` cold-tier directory). In Kubernetes the edge mounts a PVC
# here; scratch has no shell, so ownership is set up in the builder stage.
RUN mkdir -p /out/data && chown -R 65532:65532 /out/data
RUN CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -o /out/pharos-cli ./cmd/pharos-cli

FROM scratch
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/pharos-cli /pharos-cli
COPY --from=builder --chown=65532:65532 /out/data /data
WORKDIR /data
# Numeric non-root user: scratch has no /etc/passwd, so a name would not
# resolve. No HEALTHCHECK: a static binary cannot run one without a shell or
# a second client binary; liveness/readiness are the Kubernetes httpGet
# probes (deploy/k8s/) and the Compose healthchecks.
USER 65532:65532
ENTRYPOINT ["/pharos-cli"]
