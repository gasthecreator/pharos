# Pharos Central Ingestion container image (PLAN.md Slice 17: Deployment automation).
#
# CGO_ENABLED=0 static build: both gocql and segmentio/kafka-go are pure Go,
# and the edge binary's modernc.org/sqlite driver (this image doesn't need
# it, but the module graph is shared) is also pure Go -- no cgo anywhere in
# this project, so a scratch final image is genuinely sufficient, not just
# convenient.
# Builder base is pinned by digest as well as tag (supply-chain: a tag can be
# re-pushed, a digest cannot); Dependabot's docker ecosystem refreshes both.
FROM golang:1.27-alpine@sha256:f92b6ef800e499660581efdabdf25d9d817a9d124eaf900924f0504e7e27e12d AS builder
RUN apk add --no-cache ca-certificates
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -o /out/pharos-ingestion ./cmd/pharos-ingestion

FROM scratch
# CA certs for any outbound TLS this process itself initiates (Cassandra,
# Kafka client connections use their own --ca-cert flag pointing at a
# mounted Secret, not the system trust store, but the Go standard library
# still touches this path for TLS negotiation internals).
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /out/pharos-ingestion /pharos-ingestion
# Numeric non-root user: scratch has no /etc/passwd, so a name would not
# resolve. No HEALTHCHECK: a static binary cannot run one without a shell or
# a second client binary; liveness/readiness are the Kubernetes httpGet
# probes (deploy/k8s/) and the Compose healthchecks.
USER 65532:65532
EXPOSE 8081
ENTRYPOINT ["/pharos-ingestion"]
