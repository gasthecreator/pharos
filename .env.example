# Example environment for the helper scripts. Copy to `.env` (gitignored) and
# `source` it, or export the variables you need. None of the Go binaries reads
# environment variables, and docker-compose.yml reads none from an .env file,
# so nothing here is required for `docker compose up`. See docs/configuration.md
# for the full reference.

# scripts/generate_certs.sh
# CERT_DIR deletes and recreates the directory it points at. Leave unset for ./certs.
#CERT_DIR=./certs
PHAROS_TLS_DAYS=3650
# Dev-only store password. docker-compose.yml hardcodes this same value, so
# changing it also means editing the compose file.
PHAROS_TLS_STORE_PASS=pharos-dev-tls-pass

# scripts/create_topics.sh
KAFKA_BOOTSTRAP_SERVER=localhost:9092

# scripts/backup_cassandra.sh and scripts/restore_cassandra.sh
#PHAROS_BACKUP_DIR=./backup
PHAROS_BACKUP_KEYSPACE=pharos
PHAROS_BACKUP_NODES="pharos-cassandra-1 pharos-cassandra-2 pharos-cassandra-3 pharos-cassandra-4"

# scripts/loadtest_setup.sh
LOADTEST_CASSANDRA_HOSTS=127.0.0.1
LOADTEST_NUM_SITES=10

# deploy/k8s/deploy.sh and deploy/k8s/generate_k8s_certs.sh
PHAROS_K8S_NAMESPACE=pharos
#PHAROS_FORCE_REGEN_CERTS=1
